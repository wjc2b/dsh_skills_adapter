{
  "name": "dsh_skills_adapter",
  "version": "1.1.0",
  "description": "Discover Claude Code style project skills (.claude/skills) in the DeepSeek Harness",
  "main": "lib/index.js",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "skills",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "type": "module",
  "types": "lib/types/index.d.ts",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-skill": "^0.1.2-rc.1"
  }
}
